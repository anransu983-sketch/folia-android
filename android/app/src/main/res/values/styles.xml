<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <!-- 挖孔 / 刘海：窗口允许铺到顶部的摄像头区域下面。
             缺省值会把内容顶到挖孔下方，屏幕上就多出一条黑边（用户报的「摄像头安全区域」）。
             写进主题而不是只在代码里设：厂商 ROM 的「允许应用全屏显示」开关按 theme 这一项判断，
             而且它在窗口创建前就生效 —— 代码里的那次（PhoneFitCutout.apply）偏晚，个别 ROM 不认。
             shortEdges（API 27+）：竖屏横屏都铺到下沿以上的整个短边，API 26 及以下自动忽略。 -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <!-- 启动那一帧也得铺满：开屏露出 splash 以外的一条底色，就是这条没铺到顶。 -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <!--
        WebView 体检对话框（见 WebViewUpgrade）。

        必须显式给主题：MainActivity 用的是启动主题 Theme.SplashScreen，对话框默认继承
        Activity 的主题，直接跟着走会得到一块启动图背景，文字也看不清。
        DayNight 跟随系统的深浅色，和 App 自己的主题保持一致。
    -->
    <style name="WebViewUpgradeDialog" parent="Theme.AppCompat.DayNight.Dialog.Alert" />

    <!--
        音乐锁屏页：完全透明、无入场动画、不显示启动预览。

        这一层自己不画东西（内容在 WallpaperOverlay 挂在它窗口上的子窗口里），
        所以任何背景、动画或预览窗口都会被用户看见 —— 尤其是启动预览，
        会在亮屏那一瞬闪一下白色，正好毁掉"锁屏上本来就有歌词"的观感。
    -->
    <style name="LockScreenTheme" parent="@android:style/Theme.Translucent.NoTitleBar.Fullscreen">
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowDisablePreview">true</item>
    </style>
</resources>